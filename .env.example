# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional: OpenAI's Decisions API, for --provider openai and npm run benchmark.
# An API key from https://platform.openai.com/api-keys, on an organization with
# access to the Decisions preview.
OPENAI_API_KEY=
